{
  "name": "longitude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-cesium-assets.mjs --if-missing",
    "build": "next build",
    "prebuild": "node scripts/copy-cesium-assets.mjs --if-missing && prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-cesium-assets.mjs && prisma generate",
    "cesium:copy": "node scripts/copy-cesium-assets.mjs",
    "survey:build": "tsx scripts/build-survey.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:local": "node scripts/local-postgres.mjs",
    "db:local:stop": "node scripts/local-postgres.mjs --stop",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cesium": "^1.145.0",
    "gsap": "^3.15.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
