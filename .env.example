# ──────────────────────────────────────────────────────────────────────────────
# Longitude — environment variables
# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# ──────────────────────────────────────────────────────────────────────────────

# ── Cesium ion (3D world) ────────────────────────────────────────────────────
# Free access token from https://ion.cesium.com/tokens (Community plan).
# Streams the photorealistic 3D city (Google Photorealistic 3D Tiles through
# Cesium ion — no Google key or billing), Cesium World Terrain, Cesium World
# Imagery and Cesium OSM Buildings (fallback), and powers place search through
# ion's Google geocoder. It is used in the browser, so it is public by design —
# in ion you can limit it to your site's URLs.
# Without it, the 3D globe still renders (NASA Blue Marble imagery on a smooth
# ellipsoid) and the UI shows a notice explaining how to turn the 3D city on.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ── Search & attractions (optional) ──────────────────────────────────────────
# Leave blank. Search uses Google geocoding through Cesium ion (token above),
# falling back to Open-Meteo / OpenStreetMap Nominatim; attractions for
# non-curated places come from Wikipedia. Only set this if you have your own
# Google Cloud key with "Geocoding API" and "Places API (New)" (needs billing).
GOOGLE_MAPS_SERVER_API_KEY=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Matches docker-compose.yml and `npm run db:local` (embedded Postgres), both
# on port 5433 so they don't collide with another Postgres on 5432.
# Without a reachable database the site still works from the bundled catalog;
# only bookings and accounts need the database.
DATABASE_URL="postgresql://longitude:longitude@localhost:5433/longitude?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production; a development-only fallback is used when blank.
AUTH_SECRET=

# ── Email: sign-in codes (optional in development) ───────────────────────────
# Creating an account and signing in both send a 6-digit code by email. Any
# SMTP provider works. Gmail: turn on 2-Step Verification, create an App
# Password (myaccount.google.com/apppasswords), then use
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
# Resend, Brevo, Mailgun, SendGrid and Mailtrap all offer SMTP too.
# Left blank in development, no email is sent: the code is printed in the
# terminal running `npm run dev` and shown under the code boxes. Production
# refuses to issue codes until SMTP is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_SECURE=true forces implicit TLS (default: on for port 465).
SMTP_SECURE=
# The sender, e.g. "Longitude <codes@yourdomain.com>". Defaults to SMTP_USER.
MAIL_FROM=
